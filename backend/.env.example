APP_NAME="AI Decision Intelligence Platform API"
APP_ENV=development
DEBUG=True
DATABASE_URL=postgresql+psycopg://postgres:InsightIQ2026@localhost:5432/decision_intelligence
SECRET_KEY=change-this-in-production-at-least-32-bytes-long-key-string-placeholder
CORS_ORIGINS=http://localhost:5173
API_V1_PREFIX=/api/v1

# External LLM Integration (Google AI Studio - Free Tier)
GEMINI_API_KEY=
